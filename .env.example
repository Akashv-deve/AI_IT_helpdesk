# Copy to .env and edit as needed. Every value below is optional —
# the defaults shown here are what the app uses if the file is absent.

# --- Local LLM (Ollama) ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

# --- Data locations (relative to the repository root) ---
KB_PATH=data/helpdesk_kb.json
DB_PATH=data/helpdesk.db

# --- Retrieval and escalation behaviour ---
# How many knowledge-base articles to retrieve per query.
KB_TOP_K=3
# Below this match confidence (0-1) the agent raises a ticket instead of guessing.
ESCALATION_THRESHOLD=0.35

# Set to 1 to skip Ollama entirely and use deterministic rule-based reasoning.
HELPDESK_OFFLINE=0
